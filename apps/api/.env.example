# apps/api — copiar a `apps/api/.env`

PORT=8080
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3002
APP_VERSION=0.0.0-dev

# Postgres de marketing (WhatsApp, leads). Vacía en local: usa el de
# docker-compose (postgresql://postgres:postgres@localhost:5434/app_dev, ver
# `.env.example` de la raíz). En dev/prod, la del Postgres de la EC2; en
# producción es obligatoria.
DATABASE=

# Servidor Node de Saba (sin /api). Login, sesiones, permisos y datos de
# clientes salen de sus endpoints `/api/marketing/*`: esta API nunca toca la
# base de Saba. Local: el servidor de Saba corre en API_PORT (3001 por defecto).
SABA_API_URL=http://localhost:3001
# Secreto compartido con Saba: el MISMO valor que su MARKETING_SERVICE_KEY.
# Generarlo con `openssl rand -hex 32`, uno distinto por entorno. Sin él la
# API no arranca; si no coincide, Saba responde 401 a todo.
SABA_SERVICE_KEY=

# Asistente de WhatsApp (módulo assistant). Vacías: la API arranca igual y el asistente no responde.
# Mismo valor que ASSISTANT_SERVICE_KEY de Saba (no es la de marketing).
SABA_ASSISTANT_KEY=
# Llave propia, en un workspace de Anthropic con tope de gasto mensual.
ASSISTANT_ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5

TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # prueba de Cloudflare
TRUST_PROXY_HOPS=1            # proxies entre el BFF y la API (rate limit por IP)

# WhatsApp Cloud API (`.scratch/whatsapp-chats/PLAN.md`). Opcional: sin estas
# variables la API arranca igual y el webhook rechaza todo.
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=        # usuario del sistema saba-chat-api, caducidad "Nunca"
WHATSAPP_APP_SECRET=          # Saba-Chat → Configuración de la app → Básica: firma del webhook
WHATSAPP_VERIFY_TOKEN=        # lo inventas (openssl rand -hex 32); el mismo va en Meta → Webhook
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
